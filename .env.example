# ── Angel One SmartAPI (all FREE) ────────────────────────────────────────
# The server logs in on its own using the TOTP SECRET below — you NEVER type
# a Google Authenticator 6-digit code. Get the secret from
# https://smartapi.angelone.in/enable-totp (the long BASE32 string behind the QR).
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_CODE=your_client_code_here
ANGEL_MPIN=your_mpin_here
ANGEL_TOTP_SECRET=your_base32_totp_secret_here

# ── Telegram ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=from_botfather
TELEGRAM_CHAT_ID=from_userinfobot

# ── Optional overrides (sensible defaults in config) ─────────────────────
# INDEX_UNIVERSE=NIFTY100          # NIFTY50 / NIFTY100 / NIFTY200 / NIFTY500
# SCAN_MODE=eod                    # eod (once ~15:20 IST) | intraday
# SCAN_INTERVAL=ONE_DAY            # ONE_DAY | FIFTEEN_MINUTE | FIVE_MINUTE ...
# SCAN_EVERY_MIN=15                # intraday: minutes between scans
# EOD_SCAN_HHMM=1520               # eod: IST time to run the daily scan
# MAX_ALERTS_PER_SCAN=5            # cap Telegram messages per scan
# PORT=3000
